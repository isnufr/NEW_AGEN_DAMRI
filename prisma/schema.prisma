generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Armada {
  idArmada     String @id
  namaArmada   String
  tujuanArmada String
  jam          String
  harga        String
  seat         Int
  isActive     Boolean @default(true)
  hargaKhusus  HargaKhusus[]
}

model Booking {
  bookingId             String   @id
  createdAt             String
  tanggalPemberangkatan String
  jenisKendaraan        String
  tujuan                String
  harga                 Int
  nama                  String
  nomorHp               String
  jumlahPnp             Int
  waktu                 String
  nomorKursi            String
  keterangan            String
  totalHarga            Int
  pembayaran            String
  status                String
  komisi           Int      @default(0)
  totalKomisi      Int      @default(0)
  alamat           String   @default("-")
}

model Admin {
  id       String @id @default(uuid())
  username String @unique
  password String
}

model EkstraBooking {
  id               String   @id @default(uuid())
  tipe             String
  vendor           String
  rute             String
  tanggalBerangkat String
  jamBerangkat     String
  kodeBooking      String
  namaPenumpang    String
  hargaTiket       Int
  komisi           Int      @default(0)
  totalHarga       Int
  statusPembayaran String
  createdAt        String
}

model HargaKhusus {
  id           String   @id @default(uuid())
  idArmada     String
  tanggalAwal  String
  tanggalAkhir String
  hargaBaru    String
  armada       Armada   @relation(fields: [idArmada], references: [idArmada], onDelete: Cascade)
}

model Pelanggan {
  id           String   @id @default(uuid())
  nomorHp      String   @unique
  nama         String
  totalBooking Int      @default(1)
  catatan      String?
  alamat       String   @default("-")
  createdAt    DateTime @default(now())
}

model PopupIklan {
  id               String   @id @default(uuid())
  judul            String
  deskripsiSingkat String
  deskripsiLengkap String   @db.Text
  bannerUrl        String
  nomorWhatsapp    String
  pesanWhatsapp    String   @default("Halo, saya tertarik dengan iklan Anda")
  tanggalMulai     String
  tanggalBerakhir  String
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())
}
