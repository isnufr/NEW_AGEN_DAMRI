generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Armada {
  idArmada     String @id
  namaArmada   String
  tujuanArmada String
  jam          String
  harga        String
  seat         Int
  isActive     Boolean @default(true)
}

model Booking {
  bookingId             String   @id
  createdAt             String
  tanggalPemberangkatan String
  jenisKendaraan        String
  tujuan                String
  harga                 Int
  nama                  String
  nomorHp               String
  jumlahPnp             Int
  waktu                 String
  nomorKursi            String
  keterangan            String
  totalHarga            Int
  pembayaran            String
  status                String
  komisi                Int      @default(0)
  totalKomisi           Int      @default(0)
}

model Admin {
  id       String @id @default(uuid())
  username String @unique
  password String
}

model EkstraBooking {
  id               String   @id @default(uuid())
  tipe             String
  vendor           String
  rute             String
  tanggalBerangkat String
  jamBerangkat     String
  kodeBooking      String
  namaPenumpang    String
  hargaTiket       Int
  komisi           Int      @default(0)
  totalHarga       Int
  statusPembayaran String
  createdAt        String
}
