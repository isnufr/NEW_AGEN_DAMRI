generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Armada {
  idArmada     String @id
  namaArmada   String
  tujuanArmada String
  jam          String
  harga        String
  seat         Int
}

model Booking {
  bookingId             String   @id
  createdAt             String
  tanggalPemberangkatan String
  jenisKendaraan        String
  tujuan                String
  harga                 Int
  nama                  String
  nomorHp               String
  jumlahPnp             Int
  waktu                 String
  nomorKursi            String
  keterangan            String
  totalHarga            Int
  pembayaran            String
  status                String
  komisi                Int      @default(0)
  totalKomisi           Int      @default(0)
}
